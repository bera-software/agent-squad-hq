# Agent Squad HQ — server mode environment (docker compose reads ./.env).
# Copy to deploy/.env (or run deploy/install.sh, which writes it for you).
# Never commit the real file. Every SQUADHQ_X also accepts SQUADHQ_X_FILE
# (path to a mounted secret) instead of the value itself.

# --- image ---------------------------------------------------------------
SQUADHQ_IMAGE=ghcr.io/OWNER/agent-squad-hq:latest
SQUADHQ_HTTP_PORT=8080

# --- identity (docs/architecture/CONVENTIONS.md) -------------------------
SQUADHQ_HUB_REPO=your-org/agent-squad-hq
SQUADHQ_ORG=your-org
SQUADHQ_BOT_LOGIN=squadhq-ops[bot]

# --- mode ----------------------------------------------------------------
# byo-compute: coding jobs run as workflow_dispatch in your repos (GitHub-hosted runners).
# worker:      coding jobs run as sandboxed containers on this host (needs the docker socket proxy).
SQUADHQ_MODE=byo-compute
SQUADHQ_DISPATCH_WORKFLOW=squadhq-agent.yml
SQUADHQ_DISPATCH_REF=main

# --- database ------------------------------------------------------------
POSTGRES_PASSWORD=change-me
# docker-compose.yml builds SQUADHQ_DB_URL from POSTGRES_PASSWORD; set it only to use an external database.
# SQUADHQ_DB_URL=postgresql://squadhq:PASSWORD@db.example.internal:5432/squadhq?sslmode=require

# --- API tokens ----------------------------------------------------------
# name:role:sha256hex, comma separated. Roles: viewer < approver < admin.
# Create one:  docker compose run --rm api create-token --role admin --print-only
SQUADHQ_API_TOKENS=

# --- webhook secrets (unset = that source is rejected) -------------------
SQUADHQ_WEBHOOK_SECRET_GITHUB=
SQUADHQ_WEBHOOK_SECRET_JIRA=
SQUADHQ_WEBHOOK_SECRET_LINEAR=
SQUADHQ_WEBHOOK_SECRET_TRELLO=
SQUADHQ_WEBHOOK_SECRET_GITLAB=
# Trello signs body + callback URL: the public URL of /api/v1/webhooks/trello
SQUADHQ_TRELLO_CALLBACK_URL=

# --- code host / trackers ------------------------------------------------
# Token used by the control-plane modules (gh CLI) and workflow dispatch.
# Prefer a GitHub App installation token refreshed by your secrets backend.
SQUADHQ_GITHUB_TOKEN=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
LINEAR_API_KEY=
TRELLO_API_KEY=
TRELLO_TOKEN=

# --- trigger trust -------------------------------------------------------
# Who may trigger agent work (same variable as Actions mode). SQUADHQ_ALLOWED_ASSOCIATIONS is a deprecated alias.
SQUADHQ_TRUSTED_ASSOCIATIONS=OWNER,MEMBER,COLLABORATOR
# Jira/Trello/GitLab events carry no association: list trusted account ids/usernames.
SQUADHQ_TRUSTED_ACTORS=

# --- merge gate ----------------------------------------------------------
# Checks that must be present and green on the approved head commit (comma list).
SQUADHQ_REQUIRED_CHECKS=hub / ci-gate
# GitHub: required checks must come from this app and this workflow (empty workflow = any)
SQUADHQ_REQUIRED_CHECKS_APP=github-actions
SQUADHQ_REQUIRED_CHECKS_WORKFLOW=.github/workflows/agents.yml
SQUADHQ_ALLOW_FORK_MERGES=false
# POST /api/v1/runs accepts started_at within the last N days
SQUADHQ_RUN_MAX_SKEW_DAYS=7

# --- LLM providers (hub loops) -------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- worker mode sandbox -------------------------------------------------
SQUADHQ_EXECUTOR_IMAGE=ghcr.io/OWNER/agent-squad-hq-executor:latest
SQUADHQ_JOB_CPUS=2
SQUADHQ_JOB_MEMORY=4g
SQUADHQ_JOB_PIDS_LIMIT=512
SQUADHQ_JOB_NETWORK=squadhq-egress
SQUADHQ_JOB_TIMEOUT_S=3600
SQUADHQ_JOB_GITHUB_TOKEN=
SQUADHQ_SANDBOX_WORKDIR=

# --- operations ----------------------------------------------------------
SQUADHQ_LOG_LEVEL=INFO
SQUADHQ_LOG_FORMAT=json
SQUADHQ_METRICS_PUBLIC=false
SQUADHQ_API_DOCS=false
SQUADHQ_MAX_BODY_BYTES=1048576
SQUADHQ_WEBHOOK_MAX_BODY_BYTES=5242880
SQUADHQ_OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
SQUADHQ_JOB_MAX_ATTEMPTS=5
SQUADHQ_RETRY_BASE_S=10
SQUADHQ_RETRY_MAX_S=900
SQUADHQ_WORKER_LEASE_S=900
SQUADHQ_MODULE_TIMEOUT_S=1800
SQUADHQ_SCHEDULER_INTERVAL_S=20
SQUADHQ_TRUSTED_PROXIES=127.0.0.1
