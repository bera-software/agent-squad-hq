# Base URL of the Agent Squad HQ server (origin only; /api/v1 is added). Server-side only.
SQUADHQ_API_URL=http://localhost:8080
# Extra server origins a user may pick on the Settings page (comma-separated). Default: only SQUADHQ_API_URL.
SQUADHQ_API_URL_ALLOWLIST=
# 32+ random bytes; encrypts the token cookie (AES-256-GCM). Generate: openssl rand -base64 32
SQUADHQ_SESSION_SECRET=
# Optional fallback token for visitors without a session. Ignored unless SQUADHQ_DASHBOARD_ANONYMOUS=true.
SQUADHQ_API_TOKEN=
# Opt-in to anonymous access with SQUADHQ_API_TOKEN. ONLY behind an authenticating reverse proxy (SSO).
SQUADHQ_DASHBOARD_ANONYMOUS=false
# Serve built-in fixtures instead of calling the server.
MOCK_API=0
