{
  "name": "@squadhq/shared-api",
  "version": "0.1.0",
  "private": true,
  "description": "Typed client and zod schemas for the Agent Squad HQ REST API v1, shared by the dashboard and mobile apps.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./fixtures": "./src/fixtures.ts",
    "./markdown": "./src/markdown.ts"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
