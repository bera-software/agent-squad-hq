# The only agent file a project repo carries. Generated by Agent Squad HQ
# (onboarding / stub-sync); local edits are overwritten by the next sync PR.
# All logic and prompts live in the hub __HUB_REPO__, pinned to the commit of
# release __HUB_TAG__ (stub-sync bumps the pin on every hub release).
name: Agents
on:
  pull_request:
    types: [opened, synchronize, reopened, ready_for_review, labeled, closed]
  pull_request_review:
    types: [submitted]
  issues:
    types: [opened, labeled]
  # The router gates every comment-triggered agent on a trusted author association.
  issue_comment:  # zizmor: ignore[dangerous-triggers]
    types: [created]
  push:
    branches: [main]
  deployment_status: {}
  release:
    types: [published]

permissions: {}

jobs:
  hub:
    # The ceiling for every router job; each job asks for less. Agents act
    # through short-lived, per-job GitHub App tokens, not this token.
    permissions:
      contents: read
      pull-requests: write
      issues: write
      checks: read
      statuses: read
      actions: read
      # Token-broker mode (vars.SQUADHQ_TOKEN_BROKER): router prep/post jobs
      # exchange an OIDC token for App tokens; agent jobs never get it.
      id-token: write
    uses: __HUB_REPO__/.github/workflows/router.yml@__HUB_REF__ # __HUB_TAG__
    with:
      hub_repo: __HUB_REPO__
      hub_ref: __HUB_REF__
    # Named secrets only: nothing else in this repo reaches the hub.
    secrets:
      SQUADHQ_APP_PRIVATE_KEY: ${{ secrets.SQUADHQ_APP_PRIVATE_KEY }}
      SQUADHQ_AGENT_APP_PRIVATE_KEY: ${{ secrets.SQUADHQ_AGENT_APP_PRIVATE_KEY }}
      SQUADHQ_HANDOFF_KEY: ${{ secrets.SQUADHQ_HANDOFF_KEY }}
      ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
      CLAUDE_CODE_OAUTH_TOKEN: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}
      ANTHROPIC_API_KEY_1: ${{ secrets.ANTHROPIC_API_KEY_1 }}
      ANTHROPIC_API_KEY_2: ${{ secrets.ANTHROPIC_API_KEY_2 }}
      ANTHROPIC_API_KEY_3: ${{ secrets.ANTHROPIC_API_KEY_3 }}
      ANTHROPIC_API_KEY_4: ${{ secrets.ANTHROPIC_API_KEY_4 }}
      ANTHROPIC_API_KEY_5: ${{ secrets.ANTHROPIC_API_KEY_5 }}
      CLAUDE_CODE_OAUTH_TOKEN_1: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN_1 }}
      CLAUDE_CODE_OAUTH_TOKEN_2: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN_2 }}
      CLAUDE_CODE_OAUTH_TOKEN_3: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN_3 }}
      CLAUDE_CODE_OAUTH_TOKEN_4: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN_4 }}
      CLAUDE_CODE_OAUTH_TOKEN_5: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN_5 }}
      OPENAI_API_KEY: ${{ secrets.OPENAI_API_KEY }}
      GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
      SLACK_WEBHOOK_URL: ${{ secrets.SLACK_WEBHOOK_URL }}
      TEAMS_WEBHOOK_URL: ${{ secrets.TEAMS_WEBHOOK_URL }}
      DISCORD_WEBHOOK_URL: ${{ secrets.DISCORD_WEBHOOK_URL }}
      PAGERDUTY_ROUTING_KEY: ${{ secrets.PAGERDUTY_ROUTING_KEY }}
      SQUADHQ_WEBHOOK_URL: ${{ secrets.SQUADHQ_WEBHOOK_URL }}
      SQUADHQ_WEBHOOK_SECRET: ${{ secrets.SQUADHQ_WEBHOOK_SECRET }}
