# BYO-compute target for a self-hosted Squad HQ server (generated by
# onboarding; do not edit). The server dispatches this workflow with a role
# and a ticket; all logic lives in the hub __HUB_REPO__ (release __HUB_TAG__).
# secrets.SQUADHQ_SERVER_TOKEN must be a per-project REPORTER token, never admin:
#   python -m squadhq.server token create --role reporter --project <this owner/repo>
name: Squad HQ agent job
on:
  workflow_dispatch:
    inputs:
      role:
        description: Role or skill id
        required: true
      ticket:
        description: Ticket key
        required: true
      tracker:
        description: Tracker
        required: false
        default: github
      project:
        description: owner/name (this repository)
        required: true
      squadhq_job:
        description: Server job id
        required: true

permissions: {}

jobs:
  agent:
    permissions:
      contents: read
      # Token-broker mode (vars.SQUADHQ_TOKEN_BROKER): the hub's prep/post jobs
      # exchange an OIDC token for App tokens; the agent job never gets it.
      id-token: write
    uses: __HUB_REPO__/.github/workflows/squadhq-agent.yml@__HUB_REF__ # __HUB_TAG__
    with:
      role: ${{ inputs.role }}
      ticket: ${{ inputs.ticket }}
      tracker: ${{ inputs.tracker }}
      project: ${{ inputs.project }}
      squadhq_job: ${{ inputs.squadhq_job }}
      hub_repo: __HUB_REPO__
      hub_ref: __HUB_REF__
    secrets:
      SQUADHQ_APP_PRIVATE_KEY: ${{ secrets.SQUADHQ_APP_PRIVATE_KEY }}
      SQUADHQ_AGENT_APP_PRIVATE_KEY: ${{ secrets.SQUADHQ_AGENT_APP_PRIVATE_KEY }}
      SQUADHQ_HANDOFF_KEY: ${{ secrets.SQUADHQ_HANDOFF_KEY }}
      SQUADHQ_SERVER_TOKEN: ${{ secrets.SQUADHQ_SERVER_TOKEN }}
      ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
      CLAUDE_CODE_OAUTH_TOKEN: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}
      ANTHROPIC_API_KEY_1: ${{ secrets.ANTHROPIC_API_KEY_1 }}
      ANTHROPIC_API_KEY_2: ${{ secrets.ANTHROPIC_API_KEY_2 }}
      ANTHROPIC_API_KEY_3: ${{ secrets.ANTHROPIC_API_KEY_3 }}
      ANTHROPIC_API_KEY_4: ${{ secrets.ANTHROPIC_API_KEY_4 }}
      ANTHROPIC_API_KEY_5: ${{ secrets.ANTHROPIC_API_KEY_5 }}
      CLAUDE_CODE_OAUTH_TOKEN_1: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN_1 }}
      CLAUDE_CODE_OAUTH_TOKEN_2: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN_2 }}
      CLAUDE_CODE_OAUTH_TOKEN_3: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN_3 }}
      CLAUDE_CODE_OAUTH_TOKEN_4: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN_4 }}
      CLAUDE_CODE_OAUTH_TOKEN_5: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN_5 }}
      SLACK_WEBHOOK_URL: ${{ secrets.SLACK_WEBHOOK_URL }}
      TEAMS_WEBHOOK_URL: ${{ secrets.TEAMS_WEBHOOK_URL }}
      DISCORD_WEBHOOK_URL: ${{ secrets.DISCORD_WEBHOOK_URL }}
      PAGERDUTY_ROUTING_KEY: ${{ secrets.PAGERDUTY_ROUTING_KEY }}
      SQUADHQ_WEBHOOK_URL: ${{ secrets.SQUADHQ_WEBHOOK_URL }}
      SQUADHQ_WEBHOOK_SECRET: ${{ secrets.SQUADHQ_WEBHOOK_SECRET }}
